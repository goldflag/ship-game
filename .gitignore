node_modules/
dist/
.DS_Store
.impeccable/
*.log
.env*
!.env.example

.build/
*.blend1
*.blend2
*.tmp
__pycache__/

# Served copy of assets/ships/<id>/generated/comparison, rebuilt by ship:check / ship:compare.
public/ship-reference/

# Rebuildable comparison output (ship:compare, aircraft compare). Only the build record is tracked;
# ship:check verifies it and, when the output is present, every rendered file.
assets/ships/*/generated/comparison/*
!assets/ships/*/generated/comparison/build.json
assets/aircraft/*/generated/comparison/

# Rebuildable download bundles duplicate retained review files. Keep them local.
/assets/ships/*/generated/comparison/*-review.zip
/public/ship-reference/*/*-review.zip

# Rust build outputs, generated browser bindings and local match storage.
/target/
/src/generated/naval-wasm/
/.naval-data/
/src/generated/naval-version.json

# Shokaku's canonical blueprint and runtime definition already retain these inputs.
assets/ships/shokaku/reports/**/blueprint.json
assets/ships/shokaku/reports/**/definition.json
