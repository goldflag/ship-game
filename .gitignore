*.tmp
__pycache__/

# Retired ship archive paths. Research and diagnostics stay under .build/.
assets/ships/**/reports/
assets/ships/**/references/
public/ship-reference/

# Retired evidence folders for every other asset family; scripts/tests/tracked-evidence.test.ts
# rejects the general patterns. Pipeline-verified generated/review/ views, per-aircraft
# reports/export.json and assets/aircraft/references/ stay tracked, so they are not listed here.
assets/reviews/
assets/aircraft/reports/
assets/effects/**/reports/
assets/effects/**/review/
assets/effects/**/references/
assets/maps/review/
assets/hud/reports/
assets/hud/review/
assets/hud/references/
assets/audio/**/review/
assets/ships/attachment-audit/review/

# Retired ship comparisons and local aircraft comparisons.
assets/ships/*/generated/comparison/
assets/aircraft/*/generated/comparison/

# Rebuildable download bundles duplicate retained review files. Keep them local.
/assets/ships/*/generated/comparison/*-review.zip
/public/ship-reference/*/*-review.zip

# Rust build outputs, generated browser bindings and local match storage.
/target/
/src/generated/naval-wasm/
/.naval-data/
/src/generated/naval-version.json

# Derived compact runtime definitions are rebuilt by multiplayer:content.
/public/models/runtime/
