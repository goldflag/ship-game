{
    admin off
    auto_https off
    servers {
        # Cloudflare ranges: https://www.cloudflare.com/ips/ (2026-09-15).
        # The public edge appends its socket peer to the forwarded chain.
        trusted_proxies static {$EDGE_PROXY_CIDR} 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
    }
}

:8080 {
    root * /srv
    encode zstd gzip
    header X-Content-Type-Options nosniff

    handle /healthz {
        respond "ok"
    }
    handle /internal/* {
        respond "Not found" 404
    }
    @accounts path /api/auth/* /api/ships /api/ships/* /api/progress /api/progress/*
    handle @accounts {
        header Cache-Control no-store
        reverse_proxy api:8788 {
            header_up X-Forwarded-For {http.request.client_ip}
        }
    }
    handle /api/* {
        header Cache-Control no-store
        reverse_proxy server:8787 {
            # Send the resolved client alone; Rust trusts only this container.
            header_up X-Forwarded-For {http.request.client_ip}
        }
    }
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @models path /models/* /harbor/* /audio/* /maps/*
    handle @models {
        header Cache-Control "public, max-age=86400"
        file_server
    }
    handle {
        header Cache-Control no-cache
        try_files {path} /index.html
        file_server
    }
}
