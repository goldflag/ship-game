FROM rust:1.98.1-bookworm AS build
WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY assets/gameplay ./assets/gameplay
COPY assets/parts/construction/hull_shapes.rs ./assets/parts/construction/hull_shapes.rs
ENV RUSTUP_TOOLCHAIN=1.98.1 CARGO_BUILD_JOBS=1
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/source/target,sharing=locked \
    cargo build --release --locked -p naval-sim --example compile_construction && cp target/release/examples/compile_construction /compile_construction
FROM oven/bun:1.3.3
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production
COPY --from=build /compile_construction /app/compile_construction
COPY services/compiler ./services/compiler
COPY public/models/components/catalogs ./catalogs
COPY src/generated/naval-version.json ./naval-version.json
USER bun
CMD ["bun", "services/compiler/worker.ts"]
