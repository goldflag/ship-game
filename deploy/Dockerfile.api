FROM oven/bun:1.3.3
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production
COPY services ./services
# The research rules are shared with the browser; these are the API's only runtime imports from src/.
COPY src/progression/techTree.ts src/progression/rules.ts src/progression/xp.ts ./src/progression/
USER bun
CMD ["bun", "services/api/main.ts"]
