{
  "name": "bismarck-sea-trials",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "water:calibration": "bun run dev -- --open /scripts/diagnostics/ocean-calibration.html",
    "hull:prototype": "vite --config vite.hull-prototype.config.ts",
    "propeller:playground": "bun run multiplayer:prepare:dev && vite --config vite.propeller-playground.config.ts --open '/?propellerPlayground=1'",
    "dev": "bun run multiplayer:prepare:dev && vite --host 0.0.0.0",
    "build": "bun run multiplayer:prepare && bun run part:published:check && bun run part:thumbnails --check && bun run ship:check all && bun run ship:runtime:check && bun run aircraft:check all && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:naval": "bash scripts/deploy-naval.sh",
    "deploy:hermes": "bash scripts/deploy-hermes.sh",
    "bootstrap": "bun scripts/build/bootstrap.ts",
    "check": "bun scripts/tests/check.ts",
    "harness:designs": "bun scripts/browser/designs.ts",
    "ui:shot": "bun run multiplayer:prepare:dev && bun scripts/browser/shot.ts",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "typecheck": "bun run multiplayer:prepare:dev && tsc --noEmit",
    "audio:build": "python3 scripts/audio/build.py",
    "test": "bun run multiplayer:prepare:dev && bun scripts/tests/run.ts",
    "test:serial": "bun run multiplayer:prepare:dev && bun test src scripts",
    "aircraft:build": "bun scripts/aircraft/pipeline.ts build",
    "aircraft:check": "bun scripts/aircraft/pipeline.ts check",
    "aircraft:review": "bun scripts/aircraft/pipeline.ts review",
    "aircraft:thumbnail": "bun scripts/aircraft/pipeline.ts thumbnail",
    "aircraft:publish": "bun scripts/aircraft/pipeline.ts publish",
    "aircraft:inputs": "bun scripts/aircraft/pipeline.ts inputs",
    "aircraft:hash": "bun scripts/aircraft/pipeline.ts hash",
    "ship:build": "bun scripts/ships/pipeline.ts build",
    "ship:check": "bun scripts/ships/pipeline.ts check",
    "ship:compile": "bun scripts/ships/pipeline.ts compile",
    "ship:review": "bun scripts/ships/pipeline.ts review",
    "ship:thumbnail": "bun scripts/ships/pipeline.ts thumbnail",
    "ship:new": "bun scripts/construction/cli.ts new",
    "ship:hydrostatics": "bun scripts/ships/hydrostatics.ts",
    "git:setup": "bun scripts/git/setup.ts",
    "test:workflow": "bun test scripts/git scripts/ships",
    "multiplayer:definitions": "bun scripts/multiplayer/generate-rust-definitions.ts",
    "multiplayer:types": "cargo run --locked -p naval-protocol --bin export",
    "multiplayer:content": "bun scripts/multiplayer/content.ts",
    "multiplayer:wasm": "bun scripts/multiplayer/build-wasm.ts",
    "multiplayer:check": "bun scripts/multiplayer/check.ts",
    "rust:test": "bun scripts/multiplayer/rust-test.ts",
    "multiplayer:prepare": "bun scripts/multiplayer/content.ts && bun scripts/multiplayer/build-wasm.ts",
    "multiplayer:prepare:dev": "bun scripts/multiplayer/content.ts && bun scripts/multiplayer/build-wasm.ts --dev",
    "multiplayer:server": "cargo run --release --locked -p naval-server --bin naval-server",
    "multiplayer:benchmark": "cargo run --release --locked -p naval-server --bin benchmark --",
    "multiplayer:smoke": "bun scripts/multiplayer/socket-smoke.ts",
    "multiplayer:capacity-smoke": "bun scripts/multiplayer/capacity-smoke.ts",
    "model:viewer": "bun --bun vite --config vite.overlay.config.ts",
    "model:viewer:check": "tsc --project tsconfig.overlay.json --noEmit && bun test tools/ship-overlay scripts/parts",
    "part:list": "bun scripts/parts/pipeline.ts list",
    "part:inputs": "bun scripts/parts/pipeline.ts inputs",
    "part:build": "bun scripts/parts/pipeline.ts build",
    "part:check": "bun scripts/parts/pipeline.ts check",
    "part:publish": "bun scripts/parts/publish.ts publish",
    "part:published:check": "bun scripts/parts/publish.ts check",
    "ship:edit": "bun scripts/construction/cli.ts edit",
    "ship:inspect": "bun scripts/construction/cli.ts inspect",
    "ship:summary": "bun scripts/construction/cli.ts summary",
    "ship:get": "bun scripts/construction/cli.ts get",
    "ship:bounds": "bun scripts/construction/cli.ts bounds",
    "ship:near": "bun scripts/construction/cli.ts near",
    "ship:schema": "bun scripts/construction/cli.ts schema",
    "ship:place": "bun scripts/construction/cli.ts place",
    "ship:reseat": "bun scripts/construction/cli.ts reseat",
    "ship:ballast": "bun scripts/construction/cli.ts ballast",
    "ship:armor": "bun scripts/construction/cli.ts armor",
    "ship:account": "bun scripts/construction/cli.ts account",
    "ship:view": "bun scripts/construction/cli.ts view",
    "ship:session": "bun scripts/construction/cli.ts session",
    "ship:timings": "bun scripts/construction/cli.ts timings",
    "ship:mcp": "bun scripts/construction/mcp.ts",
    "ship:templates": "bun scripts/construction/cli.ts templates",
    "ship:catalog": "bun scripts/construction/cli.ts catalog",
    "ship:suggest": "bun scripts/construction/cli.ts suggest",
    "ship:apply": "bun scripts/construction/cli.ts apply",
    "ship:import": "bun scripts/construction/cli.ts import",
    "ship:export": "bun scripts/construction/cli.ts export",
    "ship:render": "bun scripts/construction/cli.ts render",
    "ship:trial": "bun scripts/construction/cli.ts trial",
    "ship:register": "bun scripts/construction/cli.ts register",
    "ship:authoring:check": "tsc --project tsconfig.construction.json --noEmit && bun test scripts/construction src/ships/constructionCommands.test.ts",
    "ship:browser:check": "bun run multiplayer:prepare:dev && bun scripts/construction/check-browser.ts",
    "accounts:server": "bun services/api/main.ts",
    "accounts:migrate": "bun services/db/migrate.ts",
    "accounts:check": "tsc -p services/tsconfig.json --noEmit && bun test services",
    "compiler:server": "bun services/compiler/worker.ts",
    "ship:runtime:check": "bun scripts/ships/runtime-assets.ts --check",
    "ship:runtime:bench": "bun scripts/diagnostics/ship-runtime-size.ts",
    "part:thumbnails": "bun scripts/parts/thumbnails.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "meshoptimizer": "1.2.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
