{
  "name": "bismarck-sea-trials",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bun run ship:check all && bun run aircraft:check all && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:naval": "bash scripts/deploy-naval.sh",
    "typecheck": "tsc --noEmit",
    "audio:build": "python3 scripts/audio/build.py",
    "test": "bun scripts/tests/run.ts",
    "test:serial": "bun test src scripts",
    "aircraft:build": "bun scripts/aircraft/pipeline.ts build",
    "aircraft:check": "bun scripts/aircraft/pipeline.ts check",
    "aircraft:review": "bun scripts/aircraft/pipeline.ts review",
    "aircraft:thumbnail": "bun scripts/aircraft/pipeline.ts thumbnail",
    "aircraft:publish": "bun scripts/aircraft/pipeline.ts publish",
    "aircraft:inputs": "bun scripts/aircraft/pipeline.ts inputs",
    "aircraft:hash": "bun scripts/aircraft/pipeline.ts hash",
    "export:ship": "bun run ship:build bismarck",
    "ship:build": "bun scripts/ships/pipeline.ts build",
    "ship:check": "bun scripts/ships/pipeline.ts check",
    "ship:compile": "bun scripts/ships/pipeline.ts compile",
    "ship:review": "bun scripts/ships/pipeline.ts review",
    "ship:thumbnail": "bun scripts/ships/pipeline.ts thumbnail",
    "ship:overlay": "vite --config vite.overlay.config.ts",
    "ship:overlay:check": "tsc --project tsconfig.overlay.json --noEmit && bun test tools/ship-overlay",
    "ship:new": "bun scripts/ships/new.ts",
    "git:setup": "bun scripts/git/setup.ts",
    "test:workflow": "bun test scripts/git scripts/ships"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "meshoptimizer": "1.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
