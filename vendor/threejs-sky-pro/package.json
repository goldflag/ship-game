  "version": "2.2.0",
  "license": "LICENSE.md",
  "type": "module",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "dev:flight": "vite --config vite.flight.config.ts",
