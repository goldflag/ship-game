    "three": ">=0.185.0"
  },
  "peerDependenciesMeta": {
    "threejs-water-pro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "three": "^0.185.0",
    "tweakpane": "^4.0.5",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitepress": "^1.5.0"
  },
  "dependencies": {
    "lucide": "^1.14.0"
  }
